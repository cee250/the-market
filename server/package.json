{
  "name": "server",
  "private": true,
  "version": "0.2.0",
  "description": "Market API — NestJS + Knex + PostgreSQL (multi-vendor marketplace backend)",
  "scripts": {
    "dev": "nest start --watch",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test test/*.test.cjs",
    "test:e2e:smoke": "npm run build && node scripts/e2e-smoke.cjs",
    "check:production-config": "npm run build && node scripts/check-production-config.cjs",
    "db:start": "node scripts/dev-db.cjs",
    "db:migrate": "knex --knexfile knexfile.cjs migrate:latest",
    "db:rollback": "knex --knexfile knexfile.cjs migrate:rollback",
    "db:seed": "knex --knexfile knexfile.cjs seed:run"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "dotenv": "^16.4.5",
    "knex": "^3.1.0",
    "nodemailer": "^10.0.10",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^5.0.6",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.0",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0"
  }
}
