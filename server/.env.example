# Copy to .env and adjust. Never commit real secrets.

# ── Server ─────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# ── Database (PostgreSQL) ──────────────────────────────────────────────
# Embedded dev instance (npm run db:start) listens on 5433.
# Docker (docker-compose up -d) / production typically listens on 5432.
DATABASE_URL=postgresql://market:market@127.0.0.1:5433/market?schema=public

# ── Auth (consumed from Phase 2) ───────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=10

# ── Seeding (npm run db:seed) ──────────────────────────────────────────
ADMIN_EMAIL=admin@market.rw
ADMIN_PASSWORD=ChangeMe123!

# ── Gmail SMTP (use a Gmail App Password, never the normal account password) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=ghsystem00@gmail.com
SMTP_PASS=
EMAIL_FROM=ghsystem00@gmail.com
APP_BASE_URL=https://market-rw.netlify.app
# Cloudinary signed vendor image uploads (store actual values as protected deployment secrets)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
